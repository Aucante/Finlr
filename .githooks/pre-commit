#!/bin/sh
# .githooks/pre-commit

echo "🔍 [Reviewer] Exécution du pré-commit..."

# 1. Récupération des fichiers PHP staggés
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ Aucun fichier PHP à analyser."
    exit 0
fi

echo "📄 Fichiers détectés :"
echo "$STAGED_FILES"

# 2. Linter rapide PHP (Vérifie la syntaxe brute de CHAQUE fichier, même hors src/)
for FILE in $STAGED_FILES; do
    php -l "$FILE" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ [REJETÉ] Erreur de syntaxe PHP dans : $FILE"
        php -l "$FILE"
        exit 1
    fi
done

# 3. Analyse statique PHPStan
echo "⚙️ Analyse PHPStan..."
./vendor/bin/phpstan analyse $STAGED_FILES --level=8 --no-progress
if [ $? -ne 0 ]; then
    echo "❌ [REJETÉ] PHPStan a détecté des erreurs de typage/logique."
    exit 1
fi

# 4. Revue IA sur le diff
echo "🤖 Revue IA du diff..."
DIFF_DATA=$(git diff --cached $STAGED_FILES)

REVIEW_RESULT=$(claude -p "Tu es un Reviewer Code PHP. Analyse ce git diff. Si tu vois une erreur de type évidente, une faille ou du code invalide, réponds uniquement 'REJETÉ:' suivi du problème. Sinon réponds 'VALIDE'." "$DIFF_DATA")

if echo "$REVIEW_RESULT" | grep -q "REJETÉ"; then
    echo "❌ [REJETÉ PAR LE REVIEWER IA] :"
    echo "$REVIEW_RESULT"
    exit 1
fi

echo "✅ [VALIDE] Commit autorisé."
exit 0
